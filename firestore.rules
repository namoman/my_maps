rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 단기 현장용: 읽기/추가만 허용 (수정·삭제 금지)
    match /pins/{pinId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'lat', 'lng', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number;
      allow update, delete: if false;
    }

    // 작업자 실시간 위치 (문서 ID = 기기별 clientId)
    match /liveLocations/{clientId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['lat', 'lng', 'updatedAt'])
                             && request.resource.data.lat is number
                             && request.resource.data.lng is number;
      allow delete: if true;
    }
  }
}
